---
import { Icon } from '../../../web/src/components/Icon';
import { TEXT, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = TEXT[lang].help;
const icons = ['shield', 'question', 'comment'] as const;
---

<section class="wrap page">
  <header class="page-head">
    <h1>{t.title}</h1>
    <p class="lead">{t.lead}</p>
  </header>
  <div class="help-grid">
    {
      t.sections.map((section, i) => (
        <article class="card help-card reveal" style={`--delay: ${i * 70}ms`}>
          <span class="chip">
            <Icon name={icons[i] ?? 'help'} size={18} />
          </span>
          <h2>{section.title}</h2>
          <p>{section.body}</p>
          <a class="text-link" href={section.href} rel={section.href.startsWith('http') ? 'noopener' : undefined}>
            {section.link}
            <Icon name="chevron-right" size={16} />
          </a>
        </article>
      ))
    }
  </div>
</section>
