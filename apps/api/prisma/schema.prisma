// MarkMySteps — Prisma schema
// M1 scope: users + refresh tokens. Trip/Stop/LocationPoint/MediaRef land in
// later milestones; the PostGIS extension is enabled from the start so geo
// columns can be added without a disruptive migration.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // postgis_topology / fuzzystrmatch / tiger geocoder are pre-installed by the
  // postgis/postgis Docker image; declaring them prevents false drift detection.
  extensions = [postgis, postgis_topology, fuzzystrmatch, postgis_tiger_geocoder]
}

enum UserRole {
  ADMIN
  USER
}

/// Whether an account may actually be used. Someone who registers lands on
/// PENDING and can do nothing at all until an admin approves them; the server
/// enforces that, not the app.
enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  /// Unique handle for adding friends to trips (never exposes the email).
  username     String   @unique
  displayName  String
  passwordHash String
  role         UserRole @default(USER)
  /// New sign-ups wait for an admin. The very first account of a fresh server
  /// approves itself — otherwise there would be nobody able to approve anyone.
  status       AccountStatus @default(PENDING)
  /// When the decision was made, and by whom (kept for the accounts list).
  decidedAt    DateTime?
  decidedById  String?   @db.Uuid
  /// Set once the app has told this user they were let in, so the message is
  /// shown once rather than on every launch.
  approvalSeen Boolean   @default(false)
  /// Set on admin-created accounts with a temporary password; cleared when
  /// the user picks their own. UI nags until then.
  mustChangePassword Boolean @default(false)
  /// Small avatar image, stored inline (kept tiny by client-side resize).
  avatar     Bytes?
  avatarMime String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens    RefreshToken[]
  immichConnection ImmichConnection?
  ownedTrips       Trip[]
  tripMemberships  TripMember[]
  mediaRefs        MediaRef[]
  locationPoints   LocationPoint[]
  notes            TripNote[]
  notifications    Notification[]   @relation("NotificationRecipient")
  notifyDevices    NotificationDevice[]
  actedNotifications Notification[] @relation("NotificationActor")
  accessRequests   TripAccessRequest[] @relation("AccessRequester")
  accessDecisions  TripAccessRequest[] @relation("AccessDecider")

  @@map("users")
}

/// Per-user link to an external Immich server. The API key is encrypted at
/// rest with AES-256-GCM (CryptoService); the plaintext only ever lives in
/// memory while talking to Immich.
model ImmichConnection {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverUrl       String
  /// Public URL used for "open in Immich" links (e.g. https://fotos.example.com);
  /// serverUrl often points at a LAN address that only the backend can reach.
  publicUrl       String?
  apiKeyEncrypted String
  lastSyncAt      DateTime?
  lastSyncError   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("immich_connections")
}

model Trip {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  /// MediaRef used as the card/hero cover; falls back to a gradient.
  coverMediaId String? @db.Uuid
  /// Auto-start route tracking (native app) once the trip has begun.
  autoTrack    Boolean @default(false)
  /// Custom trip colour (hex) for the globe/map; null = auto-assigned.
  color        String?
  /// Manual globe-marker position ([lng,lat]); null = auto (route start/end).
  /// Lets a loop trip (interrail) place its single dot + name where it fits.
  markerLng    Float?
  markerLat    Float?
  ownerId     String   @db.Uuid
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members        TripMember[]
  mediaRefs      MediaRef[]
  locationPoints LocationPoint[]
  stops          Stop[]
  shareLinks     ShareLink[]
  notes          TripNote[]
  accessRequests TripAccessRequest[]
  notifications  Notification[]

  @@map("trips")
}

/// Somebody asked the owner to let them onto a trip they can see the name of
/// (a friend's recent trips are listed on their traveller page) but not the
/// contents of. One row per person per trip: asking twice is the same ask.
enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
}

model TripAccessRequest {
  id         String              @id @default(uuid()) @db.Uuid
  tripId     String              @db.Uuid
  trip       Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  /// Who is asking.
  userId     String              @db.Uuid
  user       User                @relation("AccessRequester", fields: [userId], references: [id], onDelete: Cascade)
  status     AccessRequestStatus @default(PENDING)
  /// What they were let in as, once approved.
  grantedRole TripRole?
  /// A line they may add to say who they are / why.
  message    String?
  createdAt  DateTime            @default(now())
  decidedAt  DateTime?
  decidedById String?            @db.Uuid
  decidedBy  User?               @relation("AccessDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  notifications Notification[]

  @@unique([tripId, userId])
  @@index([userId])
  @@map("trip_access_requests")
}

/// What the app shows under the bell. A notification stays until its owner
/// deals with it — reads it away, or answers the request it carries.
enum NotificationKind {
  /// You were added to somebody's trip.
  TRIP_ADDED
  /// Somebody wants onto your trip (carries the request; owner-only).
  ACCESS_REQUESTED
  /// Your request was granted.
  ACCESS_APPROVED
  /// Your request was turned down.
  ACCESS_DENIED
}

/**
 * A phone that may ask "is there anything new?" on its own.
 *
 * The target phones have no Play Services, so there is no push service to
 * deliver anything to them. Instead the app wakes itself every quarter of an
 * hour and asks — from a background worker that lives outside the WebView and
 * therefore cannot reach the session. This token is what it uses instead: it
 * is bound to one user, it answers exactly one question (how many notifications
 * are waiting, and what the newest one says), and it can do nothing else. Only
 * its SHA-256 is stored.
 */
model NotificationDevice {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique
  /// The last notification this phone was told about, so it never says the
  /// same thing twice.
  lastSeenId   String?  @db.Uuid
  lastPolledAt DateTime?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("notification_devices")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  /// Who sees it.
  userId    String           @db.Uuid
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  /// Who caused it (the person who added you, or who is asking).
  actorId   String?          @db.Uuid
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  tripId    String?          @db.Uuid
  trip      Trip?            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  /// Set on the ones you can answer from the list.
  requestId String?          @db.Uuid
  request   TripAccessRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

enum TripRole {
  OWNER
  MEMBER
  GUEST
}

model TripMember {
  tripId   String   @db.Uuid
  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId   String   @db.Uuid
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     TripRole @default(MEMBER)
  /// A reisgenoot may share their own live track; the owner can switch this off.
  canTrack Boolean  @default(true)
  /// Cleared when somebody else puts you on a trip, so the app can say so once
  /// and then stop. Your own trips start seen — you were there when it was made.
  seen     Boolean  @default(true)
  joinedAt DateTime @default(now())

  @@id([tripId, userId])
  @@map("trip_members")
}

/// Public, read-only share link for a trip. The slug is a high-entropy
/// random token (unguessable URL); optionally protected with a password.
model ShareLink {
  id           String    @id @default(uuid()) @db.Uuid
  tripId       String    @db.Uuid
  trip         Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  slug         String    @unique
  passwordHash String?
  createdAt    DateTime  @default(now())

  @@index([tripId])
  @@map("share_links")
}

/// A planned stop on a trip. Dates are never stored — they are derived from
/// the trip start date plus the cumulative nights of all preceding stops, so
/// changing one stop's nights automatically shifts everything after it.
model Stop {
  id         String   @id @default(uuid()) @db.Uuid
  tripId     String   @db.Uuid
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name       String
  notes      String?
  nights     Int      @default(1)
  orderIndex Int
  latitude   Float?
  longitude  Float?
  /// How you travelled TO this stop from the previous one. FLIGHT draws a
  /// great-circle arc; GROUND follows a straight/route line.
  travelMode TravelMode @default(GROUND)
  /// Flight details for a FLIGHT leg (all optional / manual).
  flightNumber String?
  fromAirport  String? @db.VarChar(4) // IATA code
  toAirport    String? @db.VarChar(4)
  /// Layover airport IATA codes, in order (e.g. ["KEF"] for AMS→KEF→JFK).
  viaAirports  String[] @default([])
  /// ISO 3166-1 alpha-2, e.g. "VN" — drives the flag on the map.
  countryCode String? @db.VarChar(2)
  /// Day trip: an excursion made FROM another stop and back the same day
  /// (Saltsjöbaden → Stockholm). It is not a leg of the route — it never shifts
  /// the nights of the stops after it — but it does count as a place visited.
  parentStopId String? @db.Uuid
  parent       Stop?   @relation("StopDayTrips", fields: [parentStopId], references: [id], onDelete: Cascade)
  dayTrips     Stop[]  @relation("StopDayTrips")
  /// The single day a day trip took place. Null on a normal stop, whose dates
  /// are derived from the trip start plus the nights before it.
  dayTripDate DateTime? @db.Date
  /// Draw no line to this stop from the one before it. For a leg that is real
  /// but has nothing to draw — a stretch nobody tracked and nobody wants a
  /// straight line across either. The stop keeps its place in the route.
  hideLeg     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tripId, orderIndex])
  @@index([tripId])
  @@index([parentStopId])
  @@map("stops")
}

enum TravelMode {
  GROUND
  TRAIN
  BUS
  BOAT
  FLIGHT
}

/// A short story entry for one day of a trip (Polarsteps-style journal).
model TripNote {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @db.Uuid
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  authorId  String   @db.Uuid
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// The day this note belongs to (date only).
  day       DateTime @db.Date
  title     String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tripId, authorId, day])
  @@index([tripId, day])
  @@map("trip_notes")
}

enum PointSource {
  /// Recorded by the mobile background tracker
  TRACKED
  /// Placed by hand to complete a route
  MANUAL
  /// Auto-generated by "snap to roads" (deletable without touching real GPS)
  ROUTE_FILL
  /// Imported from an external source (e.g. Polarsteps export)
  IMPORTED
}

/// A single GPS fix on a trip route. Written in batches by the mobile
/// tracker (offline buffer → idempotent upload via clientId), by hand,
/// or by an importer.
model LocationPoint {
  id         String      @id @default(uuid()) @db.Uuid
  /// Client-generated id; makes offline batch uploads idempotent.
  clientId   String?
  tripId     String      @db.Uuid
  trip       Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId     String      @db.Uuid
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  recordedAt DateTime
  latitude   Float
  longitude  Float
  /// Horizontal accuracy in meters, if the device reported it.
  accuracy   Float?
  altitude   Float?
  source     PointSource @default(TRACKED)
  /// Generated column (see migration): ST_SetSRID(ST_MakePoint(longitude, latitude), 4326)
  geom       Unsupported("geometry(Point, 4326)")?
  createdAt  DateTime    @default(now())

  @@unique([tripId, userId, clientId])
  @@index([tripId, recordedAt])
  @@index([geom], type: Gist)
  @@map("location_points")
}

/// Reference to a photo/video that lives in Immich. MarkMySteps never stores
/// the actual media file — only the asset id plus the metadata needed to
/// place it on the map and timeline.
model MediaRef {
  id            String   @id @default(uuid()) @db.Uuid
  tripId        String   @db.Uuid
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId        String   @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  immichAssetId String
  assetType     String // IMAGE | VIDEO
  takenAt       DateTime
  latitude      Float?
  longitude     Float?
  /// Generated column (see migration): ST_SetSRID(ST_MakePoint(longitude, latitude), 4326)
  geom          Unsupported("geometry(Point, 4326)")?
  createdAt     DateTime @default(now())

  @@unique([tripId, userId, immichAssetId])
  @@index([tripId, takenAt])
  @@index([geom], type: Gist)
  @@map("media_refs")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  // SHA-256 hash of the opaque token; the raw value is only ever held by the client.
  tokenHash String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  // Set when the token is used or explicitly revoked (logout); enables reuse detection.
  revokedAt DateTime?

  @@index([userId])
  @@map("refresh_tokens")
}
