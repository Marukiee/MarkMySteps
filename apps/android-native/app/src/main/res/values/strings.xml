    <string name="local_tracking_title">Route tracking</string>
    <string name="local_tracking">Your location is kept on your phone, even without internet. The tracker runs entirely on your phone.</string>
    <string name="local_plan_title">Planning trips</string>
    <string name="local_plan">Stops, nights and transport. Everything adds up as usual.</string>
    <string name="local_photos_title">Photos from your gallery</string>
    <string name="local_photos">Photos on your phone are linked to a trip by date and put on the map with their GPS.</string>
    <string name="local_maps_title">Map, globe and timeline</string>
    <string name="local_maps">The maps and the globe get their tiles straight from OpenStreetMap. No account needed.</string>
    <string name="local_companions_title">Travel companions</string>
    <string name="local_companions">Working on one trip together and seeing each other\'s live position.</string>
    <string name="local_share_title">Share links</string>
    <string name="local_share">A private link for the folks at home needs a server to live on.</string>
    <string name="local_backup_title">Automatic backup</string>
    <string name="local_backup">Everything is on your phone. Make a backup now and then in Settings.</string>
    <string name="local_immich_title">Immich</string>
    <string name="local_immich">If you keep your photos on your own Immich server, you can connect it later.</string>
    <string name="local_later_title">Want a server later?</string>
    <string name="local_later">A server is just a computer that is always on: an old laptop with Linux and Docker, a Raspberry Pi or a NAS. Install MarkMySteps on it, make an account there and sign in to it in this app.</string>
