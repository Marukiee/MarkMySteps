    <string name="onb_welcome_title">Welcome to MarkMySteps</string>
    <string name="onb_welcome_body">Follow your route, plan your trip and look back on it later. Everything stays yours.</string>
    <string name="onb_name_title">What is your name?</string>
    <string name="onb_name_body">Without a server there is no account and no password. Your name only appears on your own trips, and stays on this phone.</string>
    <string name="onb_name_placeholder">Your name</string>
    <string name="onb_globe_title">Your trips on the map</string>
    <string name="onb_globe_body">All your trips as colourful routes on a globe, with a dot for every stop. Tap a trip to open it with your timeline and photos.</string>
    <string name="onb_plan_title">Plan your route</string>
    <string name="onb_plan_body">Build your route with stops, nights and transport: car, train, boat, or a flight with layovers. The distances and your days add up by themselves.</string>
    <string name="onb_trips_title">Look back on your trips</string>
    <string name="onb_trips_body">Every trip keeps its map, its days and its numbers. Your photos land on the right day and in the right place by themselves.</string>
    <string name="onb_share_title">Share with the folks at home</string>
    <string name="onb_share_body">One private link with your map, your days and your photos. Read only, and nobody needs to create an account.</string>
    <string name="onb_offline_title">Battery friendly and offline</string>
    <string name="onb_offline_body">Tracking goes easy on your battery and works without internet: everything is buffered and uploaded later.</string>
    <string name="onb_theme_title">Light or dark?</string>
    <string name="onb_theme_body">Pick your theme. You can always change it later in Settings.</string>
    <string name="onb_airports_title">Your usual airports</string>
    <string name="onb_airports_body">Which airports do you usually fly from? You can change this later in Settings, Preferences.</string>
    <string name="onb_granted">Permission granted</string>
    <string name="onb_denied">Denied. You can turn this on later in Settings.</string>
    <string name="onb_location_title">Location permission</string>
    <string name="onb_location_body">To track your route, the app asks for your location. A GPS point is only saved when you move, which saves your battery.</string>
    <string name="onb_location_ask">Allow location</string>
    <string name="onb_gallery_title">Your photos</string>
    <string name="onb_gallery_body">Without a server, your photos come from your phone\'s gallery. They stay where they are: the app only reads them, and nothing leaves your phone. Android only shares the place in a photo with a separate permission; without it they do not appear on the map.</string>
    <string name="onb_gallery_ask">Allow photo access</string>
    <string name="onb_notifs_title">Notifications</string>
    <string name="onb_notifs_body">Only what you need to know: the status of your tracking and updates from your travel companions. No ads, no tips, no reminders to open the app.</string>
    <string name="onb_notifs_ask">Allow notifications</string>
    <string name="onb_start_title">Start your first trip</string>
    <string name="onb_start_body">Fill in a name and your dates, and add your stops. The rest fills itself in while you travel: your route, your photos and your days.</string>
