    <string name="settings_privacy">Privacy</string>
    <string name="settings_privacy_summary">What the app keeps and who sees it</string>
    <string name="settings_privacy_intro">MarkMySteps is a travel app by Mark Maakt Media. Your route, your trips and your photos are yours. This is what the app keeps, why, and who can see it. Updated on 25 October 2026.</string>
    <string name="settings_privacy_keeps">What the app keeps</string>
    <string name="settings_privacy_account">Your account</string>
    <string name="settings_privacy_account_text">your name, username, email address and profile photo. Your password is only kept encrypted.</string>
    <string name="settings_privacy_route">Your route</string>
    <string name="settings_privacy_route_text">the location points the app records while you track a trip.</string>
    <string name="settings_privacy_trips">Your trips</string>
    <string name="settings_privacy_trips_text">titles, dates, stops, day stories and notes.</string>
    <string name="settings_privacy_comments">Comments and likes</string>
    <string name="settings_privacy_comments_text">on photos and day stories.</string>
    <string name="settings_privacy_immich">Your Immich link</string>
    <string name="settings_privacy_immich_text">the address of your Immich server and the key for it, encrypted. The photos themselves stay in your Immich; the app fetches them from there to show them.</string>
    <string name="settings_privacy_notices">Notifications</string>
    <string name="settings_privacy_notices_text">an encrypted identifier of your phone, so it can fetch new notifications.</string>
    <string name="settings_privacy_location">Your location</string>
    <string name="settings_privacy_location_text">The app only records your location when you turn on tracking for a trip yourself. While that runs, the app takes one reading per interval, even with the screen off, until you turn tracking off again. Your location goes to the MarkMySteps server and nowhere else.</string>
    <string name="settings_privacy_who">Who sees it</string>
    <string name="settings_privacy_who_companions">The travel companions you add to a trip.</string>
    <string name="settings_privacy_who_links">Anyone with a share link you make yourself, optionally with a password. Whoever comments there gives a name; likes from visitors are remembered with a random code in their own browser.</string>
    <string name="settings_privacy_who_admin">The administrator of the server, for maintenance and when you ask for help.</string>
    <string name="settings_privacy_others">Services from others</string>
    <string name="settings_privacy_others_intro">The app fetches a few things from other services. They then see your IP address and:</string>
    <string name="settings_privacy_maps">Maps</string>
    <string name="settings_privacy_maps_text">OpenFreeMap, and Esri for the satellite map: which part of the map you\'re looking at.</string>
    <string name="settings_privacy_search">Place search</string>
    <string name="settings_privacy_search_text">Photon by Komoot: what you type.</string>
    <string name="settings_privacy_weather">Weather</string>
    <string name="settings_privacy_weather_text">Open-Meteo: the coordinates of a place.</string>
    <string name="settings_privacy_place_photos">Photos of places</string>
    <string name="settings_privacy_place_photos_text">Wikipedia: the name of a place.</string>
    <string name="settings_privacy_routes">Routes between stops</string>
    <string name="settings_privacy_routes_text">OSRM for the car and signal.eu.org for the train: the coordinates of your stops.</string>
    <string name="settings_privacy_no_ads">No ads, no analytics and no tracking. Nothing is sold or shared with advertisers.</string>
    <string name="settings_privacy_where">Where it\'s kept and for how long</string>
    <string name="settings_privacy_where_text">Everything is on the MarkMySteps server and travels there encrypted (https). Your data is kept as long as your account exists.</string>
    <string name="settings_privacy_rights">Your rights</string>
    <string name="settings_privacy_rights_text">You may view your data, have it corrected, or have your account deleted with everything on it. Send an email for that; it\'s sorted within a month. If you disagree with something, you can file a complaint with the Dutch Data Protection Authority (Autoriteit Persoonsgegevens).</string>
    <string name="settings_privacy_mail">Email Mark Maakt Media</string>
