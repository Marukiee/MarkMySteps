    <string name="settings_privacy">Privacy</string>
    <string name="settings_privacy_summary">Wat de app bewaart en wie het ziet</string>
    <string name="settings_privacy_intro">MarkMySteps is een reis-app van Mark Maakt Media. Je route, je reizen en je foto\'s zijn van jou. Hier staat wat de app bewaart, waarom, en wie het kan zien. Bijgewerkt op 25 oktober 2026.</string>
    <string name="settings_privacy_keeps">Wat de app bewaart</string>
    <string name="settings_privacy_account">Je account</string>
    <string name="settings_privacy_account_text">je naam, gebruikersnaam, e-mailadres en profielfoto. Je wachtwoord wordt alleen versleuteld bewaard.</string>
    <string name="settings_privacy_route">Je route</string>
    <string name="settings_privacy_route_text">de locatiepunten die de app vastlegt terwijl je een reis bijhoudt.</string>
    <string name="settings_privacy_trips">Je reizen</string>
    <string name="settings_privacy_trips_text">titels, data, stops, dagverhalen en notities.</string>
    <string name="settings_privacy_comments">Reacties en likes</string>
    <string name="settings_privacy_comments_text">op foto\'s en dagverhalen.</string>
    <string name="settings_privacy_immich">Je Immich-koppeling</string>
    <string name="settings_privacy_immich_text">het adres van je Immich-server en de sleutel daarvoor, versleuteld. De foto\'s zelf blijven in jouw Immich; de app haalt ze daar op om ze te tonen.</string>
    <string name="settings_privacy_notices">Meldingen</string>
    <string name="settings_privacy_notices_text">een versleuteld kenmerk van je telefoon, zodat die nieuwe meldingen kan ophalen.</string>
    <string name="settings_privacy_location">Je locatie</string>
    <string name="settings_privacy_location_text">De app legt je locatie alleen vast als je zelf tracking aanzet voor een reis. Zolang dat loopt neemt de app ook met het scherm uit één meting per interval, tot je tracking weer uitzet. Je locatie gaat naar de server van MarkMySteps en nergens anders heen.</string>
    <string name="settings_privacy_who">Wie het ziet</string>
    <string name="settings_privacy_who_companions">De reisgenoten die je aan een reis toevoegt.</string>
    <string name="settings_privacy_who_links">Iedereen met een deellink die je zelf maakt, eventueel met een wachtwoord. Wie daar reageert, geeft een naam op; likes van bezoekers worden onthouden met een willekeurige code in hun eigen browser.</string>
    <string name="settings_privacy_who_admin">De beheerder van de server, voor onderhoud en als je om hulp vraagt.</string>
    <string name="settings_privacy_others">Diensten van anderen</string>
    <string name="settings_privacy_others_intro">Een paar dingen haalt de app bij andere diensten op. Die zien dan je IP-adres en:</string>
    <string name="settings_privacy_maps">Kaarten</string>
    <string name="settings_privacy_maps_text">OpenFreeMap, en Esri voor de satellietkaart: welk stuk kaart je bekijkt.</string>
    <string name="settings_privacy_search">Plaatsen zoeken</string>
    <string name="settings_privacy_search_text">Photon van Komoot: wat je intypt.</string>
    <string name="settings_privacy_weather">Weer</string>
    <string name="settings_privacy_weather_text">Open-Meteo: de coördinaten van een plaats.</string>
    <string name="settings_privacy_place_photos">Foto\'s van plaatsen</string>
    <string name="settings_privacy_place_photos_text">Wikipedia: de naam van een plaats.</string>
    <string name="settings_privacy_routes">Routes tussen stops</string>
    <string name="settings_privacy_routes_text">OSRM voor de auto en signal.eu.org voor de trein: de coördinaten van je stops.</string>
    <string name="settings_privacy_no_ads">Geen advertenties, geen analytics en geen tracking. Er wordt niets verkocht of gedeeld met adverteerders.</string>
    <string name="settings_privacy_where">Waar het staat en hoe lang</string>
    <string name="settings_privacy_where_text">Alles staat op de server van MarkMySteps en gaat er versleuteld (https) naartoe. Je gegevens blijven bewaard zolang je account bestaat.</string>
    <string name="settings_privacy_rights">Je rechten</string>
    <string name="settings_privacy_rights_text">Je mag je gegevens inzien, laten verbeteren of je account met alles erop laten verwijderen. Mail daarvoor; het is binnen een maand geregeld. Ben je het ergens niet mee eens, dan kun je een klacht indienen bij de Autoriteit Persoonsgegevens.</string>
    <string name="settings_privacy_mail">Mail Mark Maakt Media</string>
