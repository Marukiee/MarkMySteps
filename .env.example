# ============================================================
# MarkMySteps — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# --- App ---
NODE_ENV=development
API_PORT=3000
# Host port (localhost-only) that the web container binds to in production.
WEB_PORT=18790
# Public origin of the frontend (CORS allowlist)
WEB_ORIGIN=http://localhost:5173

# --- Database (internal Docker network only; no host ports) ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=markmysteps
POSTGRES_USER=markmysteps
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# Prisma connection string (derived from the values above)
DATABASE_URL=postgresql://markmysteps:change-me@db:5432/markmysteps?schema=public

# --- Auth ---
# Generate: openssl rand -base64 48
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# --- Encryption at rest (Immich API keys, AES-256-GCM) ---
# MUST be exactly 32 bytes, base64-encoded. Generate: openssl rand -base64 32
MASTER_ENCRYPTION_KEY=change-me

# --- App auto-update banner (optional; de-Googled phones have no Play Store) ---
# Easiest: point at your GitHub repo and the API reads the LATEST release
# automatically (the CI publishes each signed APK as a release). Nothing to bump
# per release. Leave unset to disable the banner.
APP_UPDATE_REPO=Marukiee/MarkMySteps
#
# Manual override instead of (or on top of) APP_UPDATE_REPO — takes precedence:
# APP_LATEST_BUILD is the APK versionCode (github.run_number) as an integer.
# APP_LATEST_BUILD=
# APP_LATEST_URL=https://github.com/Marukiee/MarkMySteps/releases/latest/download/markmysteps.apk
# APP_LATEST_NOTES=
